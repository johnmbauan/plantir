# The unique API URL of the project, used to invoke the REST APIs automatically generated by Supabase
VITE_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
# The API Key used both by the Supabase Javascript client and the REST APIs to authenticate the user.
VITE_SUPABASE_PUBLISHABLE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>